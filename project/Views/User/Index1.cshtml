<div class="container py-5">

    <!-- HEADER -->
    <div class="text-center mb-5">
        <h2 class="fw-bold mb-1">
            Welcome to <span class="text-primary">UniEvents</span>
        </h2>
        <p class="text-muted">
            Your university event management platform
        </p>
    </div>

    <!-- CARDS -->
    <div class="row justify-content-center g-4">

        <!-- BROWSE EVENTS -->
        <div class="col-lg-3 col-md-4">
            <div class="card h-100 border-0 shadow-sm rounded-4 text-center p-4">
                <div class="mb-3">
                    <span class="bg-primary bg-opacity-10 text-primary rounded-circle
                                 d-inline-flex align-items-center justify-content-center"
                          style="width:60px;height:60px;">
                        <i class="fa fa-calendar fa-lg"></i>
                    </span>
                </div>
                <h6 class="fw-bold mb-1">Browse Events</h6>
                <p class="text-muted small mb-4">
                    Discover upcoming university events
                </p>
                <a href="/Student/EventsList"
                   class="btn btn-outline-primary btn-sm px-4">
                    View Events
                </a>
            </div>
        </div>

        <!-- MY BOOKINGS -->
        <div class="col-lg-3 col-md-4">
            <div class="card h-100 border-0 shadow-sm rounded-4 text-center p-4">
                <div class="mb-3">
                    <span class="bg-success bg-opacity-10 text-success rounded-circle
                                 d-inline-flex align-items-center justify-content-center"
                          style="width:60px;height:60px;">
                        <i class="fa fa-book fa-lg"></i>
                    </span>
                </div>
                <h6 class="fw-bold mb-1">My Bookings</h6>
                <p class="text-muted small mb-4">
                    Manage your registrations
                </p>
                <a href="/Student/MyBookings"
                   class="btn btn-outline-success btn-sm px-4">
                    My Bookings
                </a>
            </div>
        </div>

        <!-- PROFILE -->
        <div class="col-lg-3 col-md-4">
            <div class="card h-100 border-0 shadow-sm rounded-4 text-center p-4">
                <div class="mb-3">
                    <span class="bg-secondary bg-opacity-10 text-secondary rounded-circle
                                 d-inline-flex align-items-center justify-content-center"
                          style="width:60px;height:60px;">
                        <i class="fa fa-user fa-lg"></i>
                    </span>
                </div>
                <h6 class="fw-bold mb-1">Your Profile</h6>
                <p class="text-muted small mb-4">
                    View your information
                </p>
                <a href="/User/Profile"
                   class="btn btn-outline-secondary btn-sm px-4">
                    View Profile
                </a>
            </div>
        </div>

    </div>
</div>
