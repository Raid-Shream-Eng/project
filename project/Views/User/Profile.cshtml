@model project.Models.User

@{
    ViewBag.Title = "ملفي الشخصي";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-7 col-md-9">

            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">

                <!-- HEADER -->
                <div class="text-center py-4 text-white" style="background: linear-gradient(135deg, #178957, #1fa06a);">
                    <h3 class="fw-bold mb-0">الملف الشخصي</h3>
                    <small class="opacity-75">معلومات حسابك</small>
                </div>

                <!-- BODY -->
                <div class="card-body bg-light p-4 text-center">

                    <!-- AVATAR -->
                    <div class="position-relative d-flex justify-content-center mb-4">
                        @if (!string.IsNullOrEmpty(Model.UImage))
                        {
                            <img src="~/images/@Model.UImage"
                                 class="rounded-circle border border-4 border-white shadow"
                                 style="width:140px;height:140px;object-fit:cover;">
                        }
                        else
                        {
                            <div class="rounded-circle bg-white border border-4 border-white shadow
                                            d-flex align-items-center justify-content-center"
                                 style="width:140px;height:140px;">
                                <i class="fas fa-user fa-4x text-muted opacity-50"></i>
                            </div>
                        }
                    </div>

                    <!-- NAME & ROLE -->
                    <h4 class="fw-bold mb-1">@Model.Name</h4>
                    <span class="badge bg-secondary px-3 py-2 mb-3">@Model.Role</span>

                    <!-- INFO CARD -->
                    <div class="card border-0 shadow-sm mx-auto mt-4" style="max-width:480px;">
                        <div class="card-body text-start">

                            <div class="mb-3 pb-2 border-bottom">
                                <small class="text-muted fw-bold d-block mb-1">الاسم</small>
                                <div class="fs-6 fw-semibold text-dark">
                                    <i class="fas fa-user text-success me-2"></i>
                                    @Model.Name
                                </div>
                            </div>

                            <div class="mb-0">
                                <small class="text-muted fw-bold d-block mb-1">البريد الإلكتروني</small>
                                <div class="fs-6 fw-semibold text-dark">
                                    <i class="fas fa-envelope text-success me-2"></i>
                                    @Model.Email
                                </div>
                            </div>

                        </div>
                    </div>

                    <!-- ACTIONS -->
                    <div class="mt-4 d-flex justify-content-center gap-2 flex-wrap">

                        @if (Context.Session.GetString("UserRole") == "Admin")
                        {
                            <a asp-controller="User" asp-action="Index2"
                               class="btn btn-outline-success px-4">
                                <i class="fas fa-home me-1"></i> الرئيسية
                            </a>
                        }
                        else
                        {
                            <a asp-controller="User" asp-action="Index1"
                               class="btn btn-outline-success px-4">
                                <i class="fas fa-home me-1"></i> الرئيسية
                            </a>
                        }

                        <a asp-controller="User" asp-action="Logout"
                           class="btn btn-danger px-4">
                            <i class="fas fa-sign-out-alt me-1"></i> تسجيل الخروج
                        </a>
                    </div>

                    <!-- CHANGE PASSWORD -->
                    <div class="mt-3">
                        <a asp-action="ChangePassword"
                           class="btn btn-link text-warning fw-semibold text-decoration-none">
                            <i class="fas fa-key me-1"></i> تغيير كلمة المرور
                        </a>
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>
