<div class="container py-5">

    <!-- HEADER -->
    <div class="text-center mb-5">
        <h2 class="fw-bold mb-1">Welcome to <span class="text-primary">UniEvents</span></h2>
        <p class="text-muted">Admin Control Panel</p>
    </div>

    <!-- CARDS -->
    <div class="row justify-content-center g-4">

        <!-- MANAGE EVENTS -->
        <div class="col-lg-3 col-md-4">
            <div class="card border-0 shadow-sm h-100 rounded-4 text-center p-4">
                <div class="mb-3">
                    <span class="bg-primary bg-opacity-10 text-primary rounded-circle d-inline-flex
                                 align-items-center justify-content-center"
                          style="width:60px;height:60px;">
                        <i class="fa fa-calendar fa-lg"></i>
                    </span>
                </div>
                <h6 class="fw-bold mb-1">Manage Events</h6>
                <p class="text-muted small mb-4">Dashboard overview</p>
                <a href="/Admin/Dashboard" class="btn btn-outline-primary btn-sm px-4">
                    Go to Dashboard
                </a>
            </div>
        </div>

        <!-- ADD EVENT -->
        <div class="col-lg-3 col-md-4">
            <div class="card border-0 shadow-sm h-100 rounded-4 text-center p-4">
                <div class="mb-3">
                    <span class="bg-success bg-opacity-10 text-success rounded-circle d-inline-flex
                                 align-items-center justify-content-center"
                          style="width:60px;height:60px;">
                        <i class="fa fa-plus fa-lg"></i>
                    </span>
                </div>
                <h6 class="fw-bold mb-1">Add Event</h6>
                <p class="text-muted small mb-4">Create new event</p>
                <a href="/Admin/CreateEvent" class="btn btn-outline-success btn-sm px-4">
                    Create Event
                </a>
            </div>
        </div>

        <!-- PROFILE -->
        <div class="col-lg-3 col-md-4">
            <div class="card border-0 shadow-sm h-100 rounded-4 text-center p-4">
                <div class="mb-3">
                    <span class="bg-secondary bg-opacity-10 text-secondary rounded-circle d-inline-flex
                                 align-items-center justify-content-center"
                          style="width:60px;height:60px;">
                        <i class="fa fa-user fa-lg"></i>
                    </span>
                </div>
                <h6 class="fw-bold mb-1">Profile</h6>
                <p class="text-muted small mb-4">View account details</p>
                <a href="/User/Profile" class="btn btn-outline-secondary btn-sm px-4">
                    View Profile
                </a>
            </div>
        </div>

    </div>
</div>
