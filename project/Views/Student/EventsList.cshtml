@model IEnumerable<project.Models.Event>

@{
    ViewData["Title"] = "الفعاليات المتاحة";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/dist/css/site.css" rel="stylesheet" />
<link href="~/plugins/fullcalendar/main.min.css" rel="stylesheet" />

<style>
    .events-page {
        direction: rtl;
        text-align: right;
    }

    .card-hover {
        transition: all .25s ease;
    }

        .card-hover:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 22px rgba(0,0,0,.12);
        }

    #calendar {
        max-width: 100%;
        margin: auto;
    }
</style>

<div class="container py-4 events-page">

    <!-- ===== PAGE TITLE ===== -->
    <div class="mb-4">
        <h2 class="fw-bold text-success">
            <i class="fas fa-calendar-alt"></i>
            الفعاليات المتاحة
        </h2>
        <p class="text-muted">ابحث عن الفعالية أو اخترها من التقويم</p>
    </div>

    <!-- ===== SEARCH ===== -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form asp-action="EventsList" method="get" class="row g-2">
                <div class="col-md-8">
                    <input type="text"
                           name="searchString"
                           class="form-control"
                           placeholder="ابحث عن اسم الفعالية أو الموقع..."
                           value="@ViewContext.HttpContext.Request.Query["searchString"]" />
                </div>
                <div class="col-md-4 d-flex gap-2">
                    <button type="submit" class="btn btn-primary flex-fill">
                        <i class="fas fa-search"></i> بحث
                    </button>
                    <a asp-action="EventsList" class="btn btn-outline-secondary flex-fill">
                        إلغاء
                    </a>
                </div>
            </form>
        </div>
    </div>

    <div class="row">

        <!-- ===== EVENTS TABLE ===== -->
        <div class="col-md-7 mb-4">
            <div class="card card-success card-hover">
                <div class="card-header">
                    <i class="fas fa-list"></i>
                    قائمة الفعاليات
                </div>

                <div class="card-body p-0">
                    <table class="table table-hover text-center align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <th>عنوان الفعالية</th>
                                <th>التاريخ</th>
                                <th>الموقع</th>
                                <th>السعة</th>
                                <th>الحالة</th>
                                <th>الإجراء</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Any())
                            {
                                int i = 1;
                                foreach (var item in Model)
                                {
                                    var myBooking = item.Rolls?.FirstOrDefault();
                                    string status = myBooking != null ? myBooking.States : "غير مسجل";

                                    <tr>
                                        <td>@i</td>
                                        <td class="fw-bold">@item.Title</td>
                                        <td>@item.Date.ToString("yyyy-MM-dd")</td>
                                        <td>@item.Location</td>
                                        <td>@item.Limit</td>
                                        <td>
                                            @if (status == "active")
                                            {
                                                <span class="badge bg-success">محجوز</span>
                                            }
                                            else if (status == "cancelled")
                                            {
                                                <span class="badge bg-danger">ملغي</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">غير مسجل</span>
                                            }
                                        </td>
                                        <td>
                                            <a asp-action="BookEvent"
                                               asp-route-eventId="@item.Id"
                                               class="btn btn-info btn-sm text-white">
                                                <i class="fas fa-eye"></i> التفاصيل
                                            </a>
                                        </td>
                                    </tr>
                                    i++;
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="7" class="text-muted py-4">
                                        لا توجد فعاليات متاحة حالياً
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- ===== CALENDAR ===== -->
        <div class="col-md-5">
            <div class="card card-success card-hover">
                <div class="card-header text-center">
                    <i class="fas fa-calendar"></i>
                    التقويم
                </div>

                <div class="card-body">
                    <div id="calendar"></div>
                </div>
            </div>
        </div>

    </div>
</div>

<script src="~/plugins/fullcalendar/main.min.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function () {

        var calendarEl = document.getElementById('calendar');

        var calendar = new FullCalendar.Calendar(calendarEl, {
            initialView: 'dayGridMonth',
            height: 450,
            direction: 'rtl',
            headerToolbar: {
                left: 'prev,next',
                center: 'title',
                right: ''
            },
            events: [
                @foreach (var e in Model)
                {
                        <text>
                        {
                            title: '@e.Title',
                            start: '@e.Date.ToString("yyyy-MM-dd")',
                            url: '@Url.Action("BookEvent", "Student", new { eventId = e.Id })'
                        },
                        </text>
                }
            ]
        });

        calendar.render();
    });
</script>
