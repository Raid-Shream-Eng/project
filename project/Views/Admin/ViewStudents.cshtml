@model project.Models.Event
@{
    ViewBag.Title = "الطلاب المسجلين";

    int currenactivetCount = ViewBag.ActiveCount ?? 0;
    int currentwaitingCount = ViewBag.WaitingCount ?? 0;
    int currentCancelCount = ViewBag.CancelCount ?? 0;
}

<div class="container mt-5" dir="rtl">

    <div class="card shadow-lg border-0 rounded-3">

        <!-- Header -->
        <div class="card-header bg-primary text-white py-3 d-flex justify-content-between align-items-center">
            <h4 class="mb-0 fw-bold">
                <i class="fas fa-users me-2"></i>
                الطلاب المسجلين في: @Model.Title
            </h4>

            <a asp-action="Dashboard" class="btn btn-light btn-sm fw-bold text-primary">
                <i class="fas fa-arrow-right me-1"></i> رجوع
            </a>
        </div>

        <div class="card-body p-4 bg-light">

            <!-- Stats -->
            <div class="row g-3 mb-4">

                <div class="col-md-3">
                    <div class="card text-center border-0 shadow-sm">
                        <div class="card-body">
                            <i class="fas fa-list fa-2x text-secondary mb-2"></i>
                            <div class="fw-bold">الإجمالي</div>
                            <div class="fs-5">@Model.Rolls?.Count </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="card text-center border-0 shadow-sm">
                        <div class="card-body">
                            <i class="fas fa-check-circle fa-2x text-success mb-2"></i>
                            <div class="fw-bold">النشط</div>
                            <div class="fs-5">@currenactivetCount</div>
                        </div>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="card text-center border-0 shadow-sm">
                        <div class="card-body">
                            <i class="fas fa-hourglass-half fa-2x text-warning mb-2"></i>
                            <div class="fw-bold">قائمة الانتظار</div>
                            <div class="fs-5">@currentwaitingCount</div>
                        </div>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="card text-center border-0 shadow-sm">
                        <div class="card-body">
                            <i class="fas fa-times-circle fa-2x text-danger mb-2"></i>
                            <div class="fw-bold">الملغي</div>
                            <div class="fs-5">@currentCancelCount</div>
                        </div>
                    </div>
                </div>

            </div>

            <!-- Empty State -->
            @if (Model.Rolls == null || !Model.Rolls.Any())
            {
                <div class="text-center py-5">
                    <i class="fas fa-user-slash fa-4x text-muted mb-3"></i>
                    <h5 class="text-muted fw-bold">
                        لا يوجد طلاب مسجلين في هذه الفعالية حتى الآن
                    </h5>
                </div>
            }
            else
            {
                <!-- Table -->
                <div class="table-responsive">
                    <table class="table table-hover align-middle shadow-sm bg-white rounded">
                        <thead class="table-light">
                            <tr>
                                <th>الطالب</th>
                                <th>البريد الإلكتروني</th>
                                <th class="text-center">الحالة</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var roll in Model.Rolls)
                            {
                                <tr>
                                    <td class="fw-bold">
                                        <i class="fas fa-user me-1 text-secondary"></i>
                                        @roll.User.Name
                                    </td>

                                    <td>
                                        <i class="fas fa-envelope me-1 text-muted"></i>
                                        @roll.User.Email
                                    </td>

                                    <td class="text-center">
                                        @if (roll.States == "active")
                                        {
                                            <span class="badge bg-success px-3 py-2">
                                                <i class="fas fa-check me-1"></i> نشط
                                            </span>
                                        }
                                        else if (roll.States == "waiting")
                                        {
                                            <span class="badge bg-warning text-dark px-3 py-2">
                                                <i class="fas fa-hourglass-half me-1"></i> انتظار
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger px-3 py-2">
                                                <i class="fas fa-times me-1"></i> ملغي
                                            </span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

        </div>
    </div>
</div>
