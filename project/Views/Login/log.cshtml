@{
    Layout = null;
    ViewBag.Title = "Login | University Event Management";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <title>University Events | Login</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <!-- ===== AdminLTE ===== -->
    <link rel="stylesheet" href="~/plugins/fontawesome-free/css/all.min.css">
    <link rel="stylesheet" href="~/dist/css/adminlte.min.css">
    <link href="~/dist/css/site.css" rel="stylesheet" />

    <!-- ===== Google Font ===== -->
    <link href="https://fonts.googleapis.com/css2?family=Quicksand&display=swap" rel="stylesheet">

    <style>
        body {
            font-family: 'Quicksand', sans-serif;
            background: url('https://lh3.googleusercontent.com/gps-cs-s/AG0ilSxsUqU7Fate5QTyuk1jZ1cT7ln0raB0Kxl8tAZnfpdhdaCACA5pGUcGtTF5nYwOjrCgHHbMJUdlj4VXAjYi_pmvZGlDgP1EL1r1iekTl6KlTo0CcBlxcNiYtDs7tk17vYrT2Vk=s1360-w1360-h1020-rw') no-repeat center center fixed;
            background-size: cover;
        }

        .login-box {
            width: 420px;
        }

        /* ===== GLASS CARD ===== */
        .card {
            background: rgba(255, 255, 255, 0.15);
            backdrop-filter: blur(8px);
            border-radius: 25px;
            box-shadow: 0 0 40px rgba(46, 204, 113, 0.5);
            color: #fff;
        }

        .login-card-body {
            background: transparent !important;
        }

        .login-logo a {
            color: #2ecc71;
            font-weight: bold;
        }

        /*       INPUTS          */
        .form-control {
            background: rgba(0,0,0,0.25);
            color: #fff;
            border: 1px solid #555;
            transition: all 0.35s ease;
        }

            .form-control::placeholder {
                color: #ddd;
            }

            /* ✅ HOVER */
            .form-control:hover {
                background: rgba(0,0,0,0.4);
                border-color: #2ecc71;
            }

            /* ✅ FOCUS */
            .form-control:focus {
                background: rgba(0,0,0,0.45);
                border-color: #2ecc71;
                box-shadow: 0 0 0 0.15rem rgba(46, 204, 113, 0.4);
                color: #fff;
            }

        /* ===== ICONS ===== */
        .input-group-text {
            background: transparent;
            border: none;
            color: #fff;
            transition: color 0.3s ease;
        }

        .input-group:hover .input-group-text {
            color: #2ecc71;
        }

        /*        BUTTON         */
        .btn-green {
            background-color: #2ecc71;
            border: none;
            color: #fff;
            font-weight: 600;
            transition: all 0.35s ease;
        }

            .btn-green:hover {
                background-color: #27ae60;
                box-shadow: 0 0 15px rgba(46, 204, 113, 0.7);
                transform: translateY(-1px);
            }

        /* ===== TEXT ===== */
        label,
        .login-box-msg {
            color: #fff;
        }

        /* ===== DEMO ===== */
        .demo-box {
            background: rgba(0,0,0,0.25);
            border-radius: 10px;
            padding: 10px;
            font-size: 14px;
            margin-top: 15px;
            text-align: center;
        }
    </style>
</head>

<body class="login-page">

    <div class="login-box">

        <div class="login-logo">
            <a href="#">
                <i class="fas fa-calendar-check"></i> University Events
            </a>
        </div>

        <div class="card">
            <div class="card-body login-card-body">

                <p class="login-box-msg text-center">
                    Sign in to access your account as<br>
                    <b>Student</b> or <b>Admin</b>
                </p>

                <form asp-controller="Login" asp-action="Log" method="post">

                    <div class="input-group mb-3">
                        <input type="email" name="email" class="form-control"
                               placeholder="University Email" required>
                        <div class="input-group-append">
                            <div class="input-group-text">
                                <span class="fas fa-envelope"></span>
                            </div>
                        </div>
                    </div>

                    <div class="input-group mb-3">
                        <input type="password" name="password" class="form-control"
                               placeholder="Password" required>
                        <div class="input-group-append">
                            <div class="input-group-text">
                                <span class="fas fa-lock"></span>
                            </div>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-green btn-block">
                        Sign In
                    </button>
                </form>

                @if (ViewBag.Error != null)
                {
                    <div class="text-danger mt-3 text-center">
                        @ViewBag.Error
                    </div>
                }

                <div class="demo-box">
                    <strong>Demo Credentials</strong><br>
                    <span><b>Admin:</b> admin@example.com / Admin123!</span><br>
                    <span><b>Student:</b> student@example.com / Student123!</span>
                </div>

            </div>
        </div>
    </div>

    <script src="~/plugins/jquery/jquery.min.js"></script>
    <script src="~/plugins/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/dist/js/adminlte.min.js"></script>

</body>
</html>